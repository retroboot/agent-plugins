# agent-plugins configuration
# Copy this file to .env and fill in required values.

# Provider configuration
# These can also be set in ~/.claude/settings.json under providerConfig.
# The session skill reads settings.json first; these env vars serve as fallback.
#
# Which provider hosts repositories and PRs/MRs:
# REPO_PROVIDER=github        # github | gitlab
#
# Which provider tracks issues (can differ from REPO_PROVIDER):
# ISSUE_TRACKER=github        # github | gitlab | linear
#
# Org / group slug for repo listing and org-level issue search:
# REPO_TARGET=your-org
#
# Provider-specific slugs — only the active provider's var is required:
# GITLAB_GROUP=your-gitlab-group
# GITHUB_ORG=your-github-org
# LINEAR_TEAM=ENG
